pipeline {
    options { buildDiscarder(logRotator(numToKeepStr: '60')) }
    agent { label 'linux' }

    stages {
        stage('CheckOutGit') {
            steps {
                checkout([$class: 'GitSCM',
                    branches: [[name: 'master']],
                    doGenerateSubmoduleConfigurations: false,
                    extensions: [],
                    submoduleCfg: [],
                    userRemoteConfigs: [[credentialsId: 'shivam_git',
                        url: 'https://github.com/Yshivamparve0204/Learn_Jenkins.git']]
                ])
            }
        }

        stage('Install_tomcat') {
            steps {
                dir('ansible') {
                   // wrap([$class: 'AnsiColorBuildWrapper', 'colorMapName': 'XTerm']) {
                        script {
                            sh "echo RDC is ${params.RDC}"
                            sh "echo Environment is ${params.Environment}"
                            sh "echo Tomcat_Version is ${params.Tomcat_Version}"
                            sh "echo User is ${params.User}"
                            //sh "sh scripts/update_wmos_cert_010626.sh ${params.Venafi_cert} ${params.RDC} ${params.Environment} ${params.user}"
                            // sh "sh scripts/update_wmos_cert.sh ${params.Venafi_cert} ${params.RDC} ${params.Environment} ${params.user}"
                        }
