pipeline {
    options { buildDiscarder(logRotator(numToKeepStr: '60')) }
    agent { label 'ubuntu' }

    stages {
        stage('CheckOutGit') {
            steps {
                checkout([$class: 'GitSCM',
                    branches: [[name: 'release']],
                    doGenerateSubmoduleConfigurations: false,
                    extensions: [],
                    submoduleCfg: [],
                    userRemoteConfigs: [[credentialsId: 'shivam_git',
                        url: 'https://github.com/Yshivamparve0204/Learn_Jenkins.git']]
                ])
            }
        }

        stage('SDNfixPack Automation') {
            steps {
                dir('ansible') {
                    wrap([$class: 'AnsiColorBuildWrapper', 'colorMapName': 'XTerm']) {
                        script {String[] SDNs = params.SDNs.split(",");
                            for(String SDN: SDNs){
                                sh "pwd"
                                sh "export ANSIBLE_FORCE_COLOR=true; ansible-playbook |
                                download_SDN_from_artifactory.yml --user=svcswmosnpd --extra-vars sdn_version=${SDN}"
                               // -extra-vars is_this_0B2=${params.OB2_or_PH1} -extra-vars workspace=${WORKSPACE}"
                              }

                        }
                    }
                }
            }
        }

    }
}


